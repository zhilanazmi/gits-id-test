              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gramedia Pustaka Utama\",\n  \"address\": \"Jl. Palmerah Barat No. 29-37, Jakarta\",\n  \"phone\": \"+62-21-53650110\",\n  \"email\": \"info@gramedia.com\"\n}"
