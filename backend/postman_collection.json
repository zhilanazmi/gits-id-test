        {
          "name": "Get Publisher Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/publishers/1",
              "host": ["{{base_url}}"],
              "path": ["publishers", "1"]
            },
            "description": "Get publisher detail including their books."
          },
          "response": []
