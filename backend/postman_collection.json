              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gramedia Pustaka Utama (Updated)\",\n  \"address\": \"Jl. Palmerah Barat No. 29-37, Jakarta Barat\",\n  \"phone\": \"+62-21-53650110\",\n  \"email\": \"contact@gramedia.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/publishers/1",
              "host": ["{{base_url}}"],
              "path": ["publishers", "1"]
            },
            "description": "Update an existing publisher."
          },
          "response": []
        },
        {
          "name": "Delete Publisher",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/publishers/1",
              "host": ["{{base_url}}"],
              "path": ["publishers", "1"]
            },
            "description": "Delete a publisher. Will also delete all associated books (cascade)."
          },
          "response": []
        }
      ]
    }
  ]
}
