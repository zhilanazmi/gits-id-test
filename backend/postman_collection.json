{
  "info": {
    "name": "Book Catalog API",
    "description": "API Documentation for Digital Book Catalog Management Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new user. Returns JWT token on success."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login with email and password. Returns JWT token. Token is automatically saved to collection variable."
          },
          "response": []
        },
        {
          "name": "Me (Get Current User)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Get the currently authenticated user's data."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Invalidate the current JWT token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authors",
      "description": "CRUD operations for Authors",
      "item": [
        {
          "name": "List Authors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/authors?page=1&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["authors"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "15"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "sort_by",
                  "value": "created_at",
                  "disabled": true
                },
                {
                  "key": "sort_order",
                  "value": "desc",
                  "disabled": true
                }
              ]
            },
            "description": "Get paginated list of authors. Supports search, sort, and pagination."
          },
          "response": []
        },
        {
          "name": "Get Author Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/authors/1",
              "host": ["{{base_url}}"],
              "path": ["authors", "1"]
            },
            "description": "Get author detail including their books."
          },
          "response": []
        },
        {
          "name": "Create Author",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"J.K. Rowling\",\n  \"bio\": \"British author best known for the Harry Potter series.\",\n  \"birth_date\": \"1965-07-31\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/authors",
              "host": ["{{base_url}}"],
              "path": ["authors"]
            },
            "description": "Create a new author.\n\nValidation:\n- name: required, string, max 255\n- bio: nullable, string, max 2000\n- birth_date: nullable, date, before today"
          },
          "response": []
        },
        {
          "name": "Update Author",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"J.K. Rowling Updated\",\n  \"bio\": \"Updated biography.\",\n  \"birth_date\": \"1965-07-31\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/authors/1",
              "host": ["{{base_url}}"],
              "path": ["authors", "1"]
            },
            "description": "Update an existing author."
          },
          "response": []
        },
        {
          "name": "Delete Author",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/authors/1",
              "host": ["{{base_url}}"],
              "path": ["authors", "1"]
            },
            "description": "Delete an author. Will also delete all associated books (cascade)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Books",
      "description": "CRUD operations for Books",
      "item": [
        {
          "name": "List Books",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books?page=1&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "15"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "author_id",
                  "value": "1",
                  "disabled": true
                },
                {
                  "key": "publisher_id",
                  "value": "1",
                  "disabled": true
                },
                {
                  "key": "published_from",
                  "value": "2020-01-01",
                  "disabled": true
                },
                {
                  "key": "published_to",
                  "value": "2024-12-31",
                  "disabled": true
                },
                {
                  "key": "sort_by",
                  "value": "created_at",
                  "disabled": true
                },
                {
                  "key": "sort_order",
                  "value": "desc",
                  "disabled": true
                }
              ]
            },
            "description": "Get paginated list of books with author and publisher relations. Supports search, filter by author/publisher, date range filter, sort, and pagination."
          },
          "response": []
        },
        {
          "name": "Get Book Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books/1",
              "host": ["{{base_url}}"],
              "path": ["books", "1"]
            },
            "description": "Get book detail including author and publisher relations."
          },
          "response": []
        },
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Harry Potter and the Philosopher's Stone\",\n  \"author_id\": 1,\n  \"publisher_id\": 1,\n  \"isbn\": \"978-0-7475-3269-9\",\n  \"description\": \"The first novel in the Harry Potter series.\",\n  \"published_at\": \"1997-06-26\",\n  \"pages\": 223\n}"
            },
            "url": {
              "raw": "{{base_url}}/books",
              "host": ["{{base_url}}"],
              "path": ["books"]
            },
            "description": "Create a new book.\n\nValidation:\n- title: required, string, max 255\n- author_id: required, must exist in authors table\n- publisher_id: required, must exist in publishers table\n- isbn: required, string, unique\n- description: nullable, string, max 5000\n- published_at: nullable, date\n- pages: nullable, integer, min 1"
          },
          "response": []
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Harry Potter and the Philosopher's Stone (Updated)\",\n  \"author_id\": 1,\n  \"publisher_id\": 1,\n  \"isbn\": \"978-0-7475-3269-9\",\n  \"description\": \"Updated description.\",\n  \"published_at\": \"1997-06-26\",\n  \"pages\": 223\n}"
            },
            "url": {
              "raw": "{{base_url}}/books/1",
              "host": ["{{base_url}}"],
              "path": ["books", "1"]
            },
            "description": "Update an existing book. ISBN uniqueness check excludes the current record."
          },
          "response": []
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books/1",
              "host": ["{{base_url}}"],
              "path": ["books", "1"]
            },
            "description": "Delete a book."
          },
          "response": []
        }
      ]
    },
